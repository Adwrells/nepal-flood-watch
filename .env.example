# Copy to .env and fill in what you need. Every value has a working default.

# Refresh cadence in minutes (10-15 is the intended range)
CYCLE_MINUTES=12

# Optional: NASA FIRMS active-fire layer.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Optional: Facebook Page monitoring via the Graph API.
# Page scraping is not supported -- it breaks Facebook's ToS. Use a token for
# Pages you own or administer.
FACEBOOK_PAGE_IDS=
FACEBOOK_TOKEN=
